<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kwamsia and Foods</title>
    <style>
        /* Simple styling to ensure the images fit nicely on screens */
        .logo-img {
            max-width: 200px;
            height: auto;
            border-radius: 8px;
            margin-bottom: 10px;
        }
        .menu-img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-top: 15px;
        }
    </style>
</head>
<body>

    <header>
        <!-- Logo Image Added Here -->
        <img src="logo.jpg" alt="Kwamsia and Foods Logo" class="logo-img">
