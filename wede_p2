<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Kwamsia and Foods</title>

    
    <link rel="stylesheet" href="style.css">
</head>

<body>

    
    <header>
        <img src="logo.jpg"
             alt="Kwamsia and Foods Logo"
             class="logo-img">

        <h1>Kwamsia and Foods</h1>

        <p>Quick, delicious meals for your daily schedule</p>
    </header>


    
    <nav>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#menu">Menu</a></li>
            <li><a href="#offers">Special Offers</a></li>
            <li><a href="#contact">Contact Us</a></li>
        </ul>
    </nav>


    
    <main>

        
        <section id="home">

            <h2>Welcome to Kwamsia and Foods</h2>

            <p>
                We provide fast, affordable, and high-quality meals
                tailored for students, workers, and community members
                on the go.
            </p>

        </section>


        
        <section id="menu">

            <h2>Our Menu</h2>

            <article>

                <h3>Daily Specials</h3>

                <p>
                    Freshly prepared lunch meals served quickly
                    to fit your break time.
                </p>

                <img src="menu.jpg"
                     alt="Kwamsia and Foods Official Menu"
                     class="menu-img">

            </article>

        </section>


        
        <section id="offers">

            <h2>Morning Order Deals</h2>

            <p>
                Place your meal order in the morning to enjoy
                exclusive discounts and zero waiting time at pickup!
            </p>

        </section>


        
        <section id="contact">

            <h2>Contact Us</h2>

            <p>
                Email:
                <a href="mailto:info@kwamsiafoods.co.za">
                    info@kwamsiafoods.co.za
                </a>
            </p>

            <p>
                Phone:
                <a href="tel:+27 63 537 4543">
                    +27 63 537 4543
                </a>
            </p>

        </section>

    </main>


    <!-- FOOTER -->
    <footer>

        <p>
             2026 Kwamsia and Foods.
            All rights reserved.
        </p>

    </footer>

</body>
</html>


**************************************************************************************************************************************************************************************

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background-color: #f8f8f8;
    color: #333;
}




header {
    text-align: center;
    background-color: #f4a261;
    padding: 30px 20px;
}

header h1 {
    font-size: 40px;
    margin: 10px 0;
}

header p {
    font-size: 18px;
}

.logo-img {
    width: 200px;
    max-width: 100%;
    height: auto;
    border-radius: 10px;
}


nav {
    background-color: #264653;
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
}

nav li {
    margin: 0;
}

nav a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 15px 25px;
    font-weight: bold;
}

nav a:hover {
    background-color: #2a9d8f;
}




main {
    width: 90%;
    max-width: 1100px;
    margin: 30px auto;
}




section {
    background-color: white;
    padding: 30px;
    margin-bottom: 25px;
    border-radius: 10px;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
}

section h2 {
    color: #264653;
    font-size: 28px;
    margin-bottom: 15px;
}

section h3 {
    color: #e76f51;
    font-size: 22px;
    margin-bottom: 10px;
}

section p {
    font-size: 17px;
    margin-bottom: 10px;
}



.menu-img {
    display: block;
    width: 100%;
    max-width: 700px;
    height: auto;
    margin: 20px auto 0;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
}




a {
    color: #2a9d8f;
}

a:hover {
    color: #e76f51;
}




footer {
    text-align: center;
    background-color: #264653;
    color: white;
    padding: 20px;
    margin-top: 30px;
}

footer p {
    margin: 0;
}





@media screen and (max-width: 768px) {

    header h1 {
        font-size: 32px;
    }

    header p {
        font-size: 16px;
    }

    nav ul {
        flex-direction: column;
        text-align: center;
    }

    nav a {
        width: 100%;
        padding: 12px;
    }

    main {
        width: 95%;
    }

    section {
        padding: 20px;
    }

    section h2 {
        font-size: 24px;
    }

}




@media screen and (max-width: 480px) {

    header {
        padding: 20px 10px;
    }

    header h1 {
        font-size: 26px;
    }

    header p {
        font-size: 15px;
    }

    .logo-img {
        width: 150px;
    }

    main {
        width: 95%;
        margin: 20px auto;
    }

    section {
        padding: 15px;
    }

    section h2 {
        font-size: 22px;
    }

    section p {
        font-size: 16px;
    }

    .menu-img {
        width: 100%;
    }

}






