void main() {
            String[] brands = {"NIKE", "ADIDAS", "REEBOK"};
            String[] quarters = {"Q1", "Q2", "Q3", "Q4"};
            int[][] sales = {
                    {100, 150, 70},
                    {88, 92, 103},
                    {75, 45, 90},
                    {65, 95, 175}
            };

            int[] total = new int[3];
            double[] average = new double[3];
            int[] minimum = new int[3];
            int[] maximum = new int[3];

            for (int brand = 0; brand < 3; brand++) {

                minimum[brand] = sales[0][brand];
                maximum[brand] = sales[0][brand];

                for (int quarter = 0; quarter < 4; quarter++) {

                    total[brand] += sales[quarter][brand];

                    if (sales[quarter][brand] < minimum[brand]) {
                        minimum[brand] = sales[quarter][brand];
                    }

                    if (sales[quarter][brand] > maximum[brand]) {
                        maximum[brand] = sales[quarter][brand];
                    }
                }

                average[brand] = total[brand] / 4.0;
            }


            // Display report
            System.out.println("ULTIMATE SHOE SALES");
            System.out.println("------------------------------------------------");
            System.out.printf("%-10s %-10s %-10s %-10s%n",
                    "QUARTER", "NIKE", "ADIDAS", "REEBOK");

            System.out.println("------------------------------------------------");


            for (int quarter = 0; quarter < 4; quarter++) {

                System.out.printf("%-10s %-10d %-10d %-10d%n",
                        quarters[quarter],
                        sales[quarter][0],
                        sales[quarter][1],
                        sales[quarter][2]);
            }


            System.out.println("------------------------------------------------");

            System.out.printf("%-10s %-10d %-10d %-10d%n",
                    "TOTAL:",
                    total[0],
                    total[1],
                    total[2]);

            System.out.printf("%-10s %-10.1f %-10.1f %-10.1f%n",
                    "AVERAGE:",
                    average[0],
                    average[1],
                    average[2]);

            System.out.printf("%-10s %-10d %-10d %-10d%n",
                    "MIN:",
                    minimum[0],
                    minimum[1],
                    minimum[2]);

            System.out.printf("%-10s %-10d %-10d %-10d%n",
                    "MAX:",
                    maximum[0],
                    maximum[1],
                    maximum[2]);

            System.out.println("------------------------------------------------");
        }
